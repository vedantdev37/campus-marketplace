# ---------------------------------------------------------------------------
# Campus Marketplace - environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#   Windows PowerShell:  Copy-Item .env.example .env.local
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Supabase dashboard -> your project -> Settings -> API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The browser-safe key. Newer Supabase dashboards label this the
# "publishable key" (sb_publishable_...); older ones call it the "anon key"
# (a long eyJ... JWT). Either works - paste whichever your dashboard shows.
# This key is PUBLIC by design. It is safe in the browser *only because*
# Row Level Security is enabled on every table. See docs/architecture.md.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: there is deliberately no service-role / secret key here.
# The app never bypasses RLS, so it never needs one.

# --- App ------------------------------------------------------------------
# Used to build absolute URLs for Supabase auth email redirects.
# Local: http://localhost:3000   Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Books API (external API: ISBN -> title/author/cover/price) ----
# Get a key at https://console.cloud.google.com (enable "Books API", then
# create an API key). Server-side only - no NEXT_PUBLIC_ prefix, so it is never
# shipped to the browser.
#
# In practice this is required for Google Books: without a key Google now
# answers 429 RESOURCE_EXHAUSTED. ISBN lookup still works if it is left blank,
# because the app falls back to Open Library, which needs no key - but no list
# price can be autofilled.
GOOGLE_BOOKS_API_KEY=

# --- Demo accounts (seed script) ------------------------------------------
# Passwords for the two seeded demo accounts, used by `npm run seed:demo`.
# Choose your own (8+ characters). They are intentionally NOT committed and
# NOT in the README: this is a public repo, so a literal anywhere in it would
# let anyone sign in and vandalise the demo data.
# Reviewers receive these in the submission notes instead.
DEMO_SELLER_PASSWORD=
DEMO_BUYER_PASSWORD=
